# (mode, model, output suffix)
JOBS = [
    ("long", "qwen", "long.md"),
    ("summary", "qwen", "summary.md"),
]

def is_server_running(url):
    """Check if the server is responding to API requests."""
    try:
        response = requests.get(f"{url}/v1/models", timeout=2)
        return response.status_code == 200
    except requests.exceptions.RequestException:
        return False


def get_loaded_model(url):
    """Return the model id reported by a responding server, or None."""
    try:
        response = requests.get(f"{url}/v1/models", timeout=2)
        response.raise_for_status()
        return response.json()["data"][0]["id"]
    except (requests.exceptions.RequestException, KeyError, IndexError, ValueError):
        return None


def is_process_running(name):
    """Check if a live (non-zombie) process with the given name exists."""
    for proc in psutil.process_iter(['name', 'status']):
        if proc.info['name'] == name and proc.info['status'] != psutil.STATUS_ZOMBIE:
            return True
    return False


def stop_server():
    """Terminate any running llama-server processes and wait for them to exit."""
    procs = [p for p in psutil.process_iter(['name']) if p.info['name'] == "llama-server"]
    if not procs:
        return
    print(f"🛑 Stopping llama-server (pid {', '.join(str(p.pid) for p in procs)})...")
    for p in procs:
        try:
            p.terminate()
        except psutil.NoSuchProcess:
            pass
    _, alive = psutil.wait_procs(procs, timeout=30)
    for p in alive:
        try:
            p.kill()
        except psutil.NoSuchProcess:
            pass
    psutil.wait_procs(alive, timeout=10)


def ensure_server(model_name, url):
    """Make sure llama-server is running with the requested model, swapping if needed."""
    model = MODELS[model_name]
    wanted = os.path.basename(model["path"])
    loaded = get_loaded_model(url)
    if loaded is not None:
        if wanted in loaded:
            print(f"✅ Llama-server is already running with {wanted}.")
            return True
        print(f"🔄 Llama-server has {loaded}, but {wanted} is needed. Swapping models...")
        stop_server()
    if not start_server(model):
        return False
    # A server that was still starting up when we checked may have the wrong model.
    loaded = get_loaded_model(url)
    if loaded is not None and wanted not in loaded:
        print(f"🔄 Server came up with {loaded}, but {wanted} is needed. Swapping models...")
        stop_server()
        return start_server(model)
    return True


def start_server(model):
    """Start the llama-server in the background if it's not already running."""
    if is_server_running(LLAMA_URL):
        print("✅ Llama-server is already running and responding.")
        return True

    if is_process_running("llama-server"):
        print("⏳ Llama-server process is running but not responding yet. Waiting...")
    else:
        print("🚀 Llama-server is not running. Starting it now...")
        cmd = [LLAMA_SERVER_BIN, "-m", model["path"]] + model["args"]

        print(f"📡 Command issued: {' '.join(cmd)}")
        print(f"📝 Logs are being written to {LOG_PATH}")

        try:
            # Open file in context manager; Popen inherits the file descriptor
            with open(LOG_PATH, "a") as log_file:
                subprocess.Popen(
                    cmd,
                    stdout=log_file,
                    stderr=log_file,
                    start_new_session=True
                )
        except Exception as e:
            print(f"❌ Error starting llama-server process: {e}")
            return False

    # Polling loop
    print("⌛ Waiting for server to become ready (this may take a minute)...")
    start_time = time.time()
    while time.time() - start_time < 300:  # 5 minute timeout
        if is_server_running(LLAMA_URL):
            print("\n✅ Llama-server is ready!")
            return True
        if not is_process_running("llama-server"):
            print(f"\n❌ Error: llama-server exited during startup. Check {LOG_PATH}")
            return False
        print(".", end="", flush=True)
        time.sleep(2)

    print("\n❌ Error: Timeout waiting for llama-server to start.")
    return False


def generate_summary(transcript, output_path, max_tokens, url, mode, model_name):
    """Send the transcript to the server and stream the response to a file."""
    prompts = PROMPTS[mode]

    print(f"📝 Generating {mode} notes with {model_name} → {output_path}")
    print(f"💡 Monitor progress in another terminal: tail -f '{output_path}'")
    print("-" * 40)

    payload = {
        "model": os.path.basename(MODELS[model_name]["path"]),
        "messages": [
            {"role": "system", "content": prompts["system"]},
            {"role": "user", "content": f"{prompts['user_prefix']}\n\n{transcript}"}
        ],
        "max_tokens": max_tokens,
        "temperature": 0,
        "stream": True,
        "return_progress": True,    # prompt_progress: {total, cache, processed, time_ms}
        "timings_per_token": True   # timings: {predicted_n, predicted_per_second, ...}
    }

    # Two-phase progress bars (render to stderr so stdout/tail -f stay clean).
    # Phase 1: prompt ingestion (determinate % from prompt_progress).
    # Phase 2: generation (token count + tok/s; determinate only if max_tokens > 0).
    prompt_bar = None
    gen_bar = None

    def close_bars():
        for bar in (prompt_bar, gen_bar):
            if bar is not None:
                bar.close()

    try:
        response = requests.post(
            f"{url}/v1/chat/completions",
            headers={"Content-Type": "application/json"},
            json=payload,
            stream=True
        )
        response.raise_for_status()

        with open(output_path, 'w') as f_out:
            for line in response.iter_lines():
                if line:
                    decoded_line = line.decode('utf-8')
                    if decoded_line.startswith("data: "):
                        data_str = decoded_line[len("data: "):]
                        if data_str.strip() == "[DONE]":
                            break
                        try:
                            data = json.loads(data_str)
                        except json.JSONDecodeError:
                            continue

                        # Phase 1: prompt-processing progress. The server's
                        # prompt_progress.total can undershoot the real prompt
                        # size, making the bar hit 100% while prefill is still
                        # running. Clamp total to the largest of total/n_prompt/
                        # processed so it never shows 100% prematurely.
                        progress = data.get("prompt_progress")
                        if progress and gen_bar is None:
                            total = progress.get("total", 0)
                            processed = progress.get("processed", 0)
                            n_prompt = progress.get("n_prompt_tokens", 0)
                            total = max(total, n_prompt, processed)
                            if prompt_bar is None:
                                prompt_bar = tqdm(
                                    total=total or None,
                                    desc="Prompt", unit="tok", unit_scale=True,
                                    file=sys.stderr, leave=True
                                )
                            if total and prompt_bar.total != total:
                                prompt_bar.total = total
                            prompt_bar.update(max(0, processed - prompt_bar.n))

                        # Content tokens => generation phase has begun
                        try:
                            content = data['choices'][0]['delta'].get('content', '')
                        except (KeyError, IndexError):
                            content = ''
                        timings = data.get("timings", {})

                        if content or (timings and gen_bar is not None):
                            if gen_bar is None:
                                if prompt_bar is not None:
                                    prompt_bar.close()
                                gen_bar = tqdm(
                                    total=(max_tokens if max_tokens and max_tokens > 0 else None),
                                    desc="Generating", unit="tok", unit_scale=True,
                                    file=sys.stderr, leave=True
                                )
                            if content:
                                f_out.write(content)
                                f_out.flush()
                            predicted_n = timings.get("predicted_n")
                            if predicted_n is not None:
                                gen_bar.update(max(0, predicted_n - gen_bar.n))
                            elif content:
                                gen_bar.update(1)
                            tps = timings.get("predicted_per_second")
                            if tps is not None:
                                gen_bar.set_postfix_str(f"{tps:.1f} tok/s")

        close_bars()
        print(f"\n✅ {mode.capitalize()} notes ({model_name}) saved to: {output_path}")

    except requests.exceptions.RequestException as e:
        close_bars()
        print(f"\n❌ Error calling llama-server: {e}")


def main():
    parser = argparse.ArgumentParser(
        description="Generate meeting notes using a local LLM: a long record "
                    "plus summary notes."
    )
    parser.add_argument("transcript", help="Path to the transcript text file.")
    parser.add_argument(
        "output",
        nargs="?",
        help="Base path for output files (default: the transcript path). "
             "Outputs are <base>.long.md and <base>.summary.md."
    )
    parser.add_argument(
        "--max-tokens",
        type=int,
        default=DEFAULT_MAX_TOKENS,
        help="Max output tokens (default: -1)."
    )
    parser.add_argument(
        "--url",
        default=LLAMA_URL,
        help=f"llama-server URL (default: {LLAMA_URL})."
    )
    select = parser.add_mutually_exclusive_group()
    select.add_argument("--long-only", action="store_true",
                        help="Only generate the long record.")
    select.add_argument("--summary-only", action="store_true",
                        help="Only generate the summary notes.")

    args = parser.parse_args()

    if not os.path.exists(args.transcript):
        print(f"❌ Error: File not found: {args.transcript}")
        sys.exit(1)

    base = args.output or args.transcript
    if base.endswith(".md"):
        base = base[:-len(".md")]

    jobs = JOBS
    if args.long_only:
        jobs = [j for j in jobs if j[0] == "long"]
    elif args.summary_only:
        jobs = [j for j in jobs if j[0] == "summary"]

    with open(args.transcript, 'r', encoding='utf-8', errors='replace') as f:
        transcript = f.read()
    print(f"📖 Read transcript from {args.transcript} ({len(transcript)} chars)")

    for mode, model_name, suffix in jobs:
        if not ensure_server(model_name, args.url):
            sys.exit(1)
        generate_summary(transcript, f"{base}.{suffix}", args.max_tokens,
                         args.url, mode, model_name)


if __name__ == "__main__":
    main()
