}

PROMPTS = {
    "long": {
        "system": (
            "You are an expert transcription analyst. Produce a verbatim-adjacent, exhaustive report of the meeting. "
            "Capture the full depth of technical discussions, side-bars, and nuanced context. Do not omit details for brevity. "
